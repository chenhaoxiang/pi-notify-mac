{
  "name": "pi-notify-mac",
  "version": "0.3.0",
  "description": "macOS completion and waiting-for-input reminders for Pi, with cancellable alerts, sound and terminal focus.",
  "license": "MIT",
  "author": "chenhaoxiang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenhaoxiang/pi-notify-mac.git"
  },
  "homepage": "https://github.com/chenhaoxiang/pi-notify-mac#readme",
  "bugs": "https://github.com/chenhaoxiang/pi-notify-mac/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "macos",
    "notifications"
  ],
  "os": [
    "darwin"
  ],
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "docs/releasing.md",
    "docs/notification-completion.md",
    "docs/notification-diagnostics.md",
    "docs/settled-ui-resume.md",
    "docs/input-reminders.md",
    "install.sh",
    "scripts/install-local.mjs"
  ],
  "pi": {
    "extensions": [
      "./src/pi-notify-mac.ts"
    ]
  },
  "scripts": {
    "test": "node --no-warnings --experimental-vm-modules --test --test-concurrency=1 test/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
